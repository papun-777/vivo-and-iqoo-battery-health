  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { STLExporter } from 'three/addons/exporters/STLExporter.js';
    import * as BufferGeometryUtils from 'three/addons/utils/BufferGeometryUtils.js';

    // --- Scene & Renderer Setup ---
    const container = document.getElementById('viewport');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0b0f19);

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 1, 2000);
    camera.position.set(0, 160, 360);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(0, 90, 0);
    controls.enableDamping = true;
    controls.update();

    // --- Build Plate Reference Grid (250x250mm standard bed) ---
    const grid = new THREE.GridHelper(250, 25, 0xf59e0b, 0x1e293b);
    scene.add(grid);

    // --- Lighting ---
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.45);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 0.7);
    dirLight.position.set(150, 300, 200);
    scene.add(dirLight);

    // Internal Warm Bulb Light
    const bulbLight = new THREE.PointLight(0xff9933, 3.5, 450, 1.2);
    bulbLight.position.set(0, 85, 0);
    scene.add(bulbLight);

    const bulbGeo = new THREE.SphereGeometry(18, 24, 24);
    const bulbMat = new THREE.MeshBasicMaterial({ color: 0xffddaa });
    const bulbMesh = new THREE.Mesh(bulbGeo, bulbMat);
    bulbMesh.position.copy(bulbLight.position);
    scene.add(bulbMesh);

    // --- Lampshade Material ---
    const shadeMaterial = new THREE.MeshPhysicalMaterial({
      color: 0xfffaf0,
      emissive: 0xff7711,
      emissiveIntensity: 0.18,
      roughness: 0.35,
      metalness: 0.0,
      transmission: 0.35,
      thickness: 2.5,
      side: THREE.DoubleSide
    });

    let shadeMesh = null;

    // --- Radius Evaluation Function ---
    function getOuterRadius(v, theta, p) {
      // Base linear interpolation
      let r = p.bottomRadius * (1 - v) + p.topRadius * v;

      // Vertical profile curve
      if (p.profileType === 'bulge') {
        r += p.profileAmp * 4 * v * (1 - v);
      } else if (p.profileType === 'scallop') {
        r += p.profileAmp * Math.sin(v * Math.PI * 2);
      } else if (p.profileType === 'hour') {
        r += p.profileAmp * Math.sin(v * Math.PI * 2) * (1 - v * 0.5);
      }

      // Twist angle along height
      const twistRad = (p.twistAngle * Math.PI / 180) * v;
      const angle = theta + twistRad;

      // Radial ribs with adjustable sharpness
      let ribOffset = 0;
      if (p.ribCount > 0 && p.ribDepth > 0) {
        const rawWave = Math.sin(p.ribCount * angle);
        const shapedWave = Math.sign(rawWave) * Math.pow(Math.abs(rawWave), p.ribSharpness);
        ribOffset = p.ribDepth * shapedWave;
      }

      // Vertical ripple wave cross-pattern
      if (p.vWaveFreq > 0 && p.vWaveAmp > 0) {
        const vWave = p.vWaveAmp * Math.sin(v * Math.PI * 2 * p.vWaveFreq + theta * 2);
        ribOffset += vWave;
      }

      return Math.max(8, r + ribOffset);
    }

    // --- Build watertight tubular wall ---
    function createShellGeometry(p) {
      const M = p.radSeg;
      const N = p.heightSeg;
      const positions = [];
      const indices = [];

      // Ring 0..(N): Outer wall bottom-to-top
      for (let i = 0; i <= N; i++) {
        const v = i / N;
        const y = v * p.height;
        for (let j = 0; j < M; j++) {
          const theta = (j / M) * Math.PI * 2;
          const rOut = getOuterRadius(v, theta, p);
          positions.push(rOut * Math.cos(theta), y, rOut * Math.sin(theta));
        }
      }

      // Ring (N+1)..(2N+1): Inner wall bottom-to-top
      for (let i = 0; i <= N; i++) {
        const v = i / N;
        const y = v * p.height;
        for (let j = 0; j < M; j++) {
          const theta = (j / M) * Math.PI * 2;
          const rOut = getOuterRadius(v, theta, p);
          const rIn = Math.max(4, rOut - p.wallThickness);
          positions.push(rIn * Math.cos(theta), y, rIn * Math.sin(theta));
        }
      }

      const outerOffset = 0;
      const innerOffset = (N + 1) * M;

      function addQuad(a, b, c, d) {
        indices.push(a, b, c);
        indices.push(a, c, d);
      }

      // Outer Wall Faces
      for (let i = 0; i < N; i++) {
        for (let j = 0; j < M; j++) {
          const nextJ = (j + 1) % M;
          const a = outerOffset + i * M + j;
          const b = outerOffset + i * M + nextJ;
          const c = outerOffset + (i + 1) * M + nextJ;
          const d = outerOffset + (i + 1) * M + j;
          addQuad(a, c, b, d); // Outward normal
        }
      }

      // Inner Wall Faces
      for (let i = 0; i < N; i++) {
        for (let j = 0; j < M; j++) {
          const nextJ = (j + 1) % M;
          const a = innerOffset + i * M + j;
          const b = innerOffset + i * M + nextJ;
          const c = innerOffset + (i + 1) * M + nextJ;
          const d = innerOffset + (i + 1) * M + j;
          addQuad(a, b, c, d); // Inward normal
        }
      }

      // Bottom Rim Cap (connects Outer i=0 to Inner i=0)
      for (let j = 0; j < M; j++) {
        const nextJ = (j + 1) % M;
        const outA = outerOffset + j;
        const outB = outerOffset + nextJ;
        const inB = innerOffset + nextJ;
        const inA = innerOffset + j;
        addQuad(outA, outB, inB, inA);
      }

      // Top Rim Cap (connects Outer i=N to Inner i=N)
      for (let j = 0; j < M; j++) {
        const nextJ = (j + 1) % M;
        const outA = outerOffset + N * M + j;
        const outB = outerOffset + N * M + nextJ;
        const inB = innerOffset + N * M + nextJ;
        const inA = innerOffset + N * M + j;
        addQuad(outA, inA, inB, outB);
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geo.setIndex(indices);
      const nonIndexed = geo.toNonIndexed();
      nonIndexed.computeVertexNormals();
      return nonIndexed;
    }

    // --- Helper to build closed ring (hollow cylinder) ---
    function createClosedRing(rInner, rOuter, height, yCenter, segs = 72) {
      const positions = [];
      const indices = [];
      const yBot = yCenter - height / 2;
      const yTop = yCenter + height / 2;

      // 0: Outer Bot, 1: Outer Top, 2: Inner Bot, 3: Inner Top
      for (let ring = 0; ring < 4; ring++) {
        const r = ring < 2 ? rOuter : rInner;
        const y = (ring % 2 === 0) ? yBot : yTop;
        for (let j = 0; j < segs; j++) {
          const theta = (j / segs) * Math.PI * 2;
          positions.push(r * Math.cos(theta), y, r * Math.sin(theta));
        }
      }

      function addQuad(a, b, c, d) {
        indices.push(a, b, c, a, c, d);
      }

      for (let j = 0; j < segs; j++) {
        const nextJ = (j + 1) % segs;
        // Outer wall
        addQuad(j, segs + nextJ, nextJ, segs + j);
        // Inner wall
        addQuad(2 * segs + j, 2 * segs + nextJ, 3 * segs + nextJ, 3 * segs + j);
        // Bottom face
        addQuad(j, nextJ, 2 * segs + nextJ, 2 * segs + j);
        // Top face
        addQuad(segs + j, 3 * segs + j, 3 * segs + nextJ, segs + nextJ);
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geo.setIndex(indices);
      const nonIndexed = geo.toNonIndexed();
      nonIndexed.computeVertexNormals();
      return nonIndexed;
    }

    // --- Build Socket Fitter Assembly ---
    function createFitterGeometries(p) {
      if (p.fitterPos === 'none') return [];

      const parts = [];
      const isTop = p.fitterPos === 'top';
      const vAnchor = isTop ? 1.0 : 0.0;
      const fitterThickness = 4.0;
      const yCenter = isTop ? (p.height - fitterThickness / 2) : (fitterThickness / 2);

      const holeRadius = p.holeDia / 2;
      const hubOuterRadius = holeRadius + 5.5;

      // Calculate minimum inner radius at the anchor rim so the outer ring merges cleanly
      let minR = Infinity;
      for (let j = 0; j < 72; j++) {
        const theta = (j / 72) * Math.PI * 2;
        const r = getOuterRadius(vAnchor, theta, p) - p.wallThickness;
        if (r < minR) minR = r;
      }

      if (minR <= hubOuterRadius + 2) return []; // Shade too narrow for socket

      // 1. Center Hub Ring
      parts.push(createClosedRing(holeRadius, hubOuterRadius, fitterThickness, yCenter, 72));

      // 2. Inner Wall Ledge Ring (bonds spokes to irregular/ribbed shade wall)
      const ledgeInner = minR - 2.5;
      const ledgeOuter = minR + p.wallThickness * 0.65;
      parts.push(createClosedRing(ledgeInner, ledgeOuter, fitterThickness, yCenter, 96));

      // 3. Radial Spokes
      const spokeLength = (ledgeInner - hubOuterRadius) + 3.0;
      const spokeMidR = hubOuterRadius + (ledgeInner - hubOuterRadius) / 2;
      const spokeWidth = 6.5;

      for (let s = 0; s < p.spokeCount; s++) {
        const angle = (s / p.spokeCount) * Math.PI * 2;
        const boxGeo = new THREE.BoxGeometry(spokeLength, fitterThickness, spokeWidth);
        boxGeo.translate(spokeMidR, yCenter, 0);
        boxGeo.rotateY(angle);
        parts.push(boxGeo.toNonIndexed());
      }

      return parts;
    }

    // --- Read UI Parameters & Rebuild Mesh ---
    function getParams() {
      return {
        height: parseFloat(document.getElementById('height').value),
        bottomRadius: parseFloat(document.getElementById('bottomRadius').value),
        topRadius: parseFloat(document.getElementById('topRadius').value),
        wallThickness: parseFloat(document.getElementById('wallThickness').value),
        profileType: document.getElementById('profileType').value,
        profileAmp: parseFloat(document.getElementById('profileAmp').value),
        ribCount: parseInt(document.getElementById('ribCount').value),
        ribDepth: parseFloat(document.getElementById('ribDepth').value),
        ribSharpness: parseFloat(document.getElementById('ribSharpness').value),
        twistAngle: parseFloat(document.getElementById('twistAngle').value),
        vWaveFreq: parseInt(document.getElementById('vWaveFreq').value),
        vWaveAmp: parseFloat(document.getElementById('vWaveAmp').value),
        fitterPos: document.getElementById('fitterPos').value,
        holeDia: parseFloat(document.getElementById('holeDia').value),
        spokeCount: parseInt(document.getElementById('spokeCount').value),
        radSeg: parseInt(document.getElementById('radSeg').value),
        heightSeg: parseInt(document.getElementById('heightSeg').value)
      };
    }

    function updateLabels(p) {
      document.getElementById('val-height').textContent = `${p.height} mm`;
      document.getElementById('val-bottomRadius').textContent = `${p.bottomRadius} mm`;
      document.getElementById('val-topRadius').textContent = `${p.topRadius} mm`;
      document.getElementById('val-wallThickness').textContent = `${p.wallThickness.toFixed(1)} mm`;
      document.getElementById('val-profileAmp').textContent = `${p.profileAmp} mm`;
      document.getElementById('val-ribCount').textContent = `${p.ribCount}`;
      document.getElementById('val-ribDepth').textContent = `${p.ribDepth.toFixed(1)} mm`;
      document.getElementById('val-ribSharpness').textContent = `${p.ribSharpness.toFixed(1)}`;
      document.getElementById('val-twistAngle').textContent = `${p.twistAngle}°`;
      document.getElementById('val-vWaveFreq').textContent = `${p.vWaveFreq}`;
      document.getElementById('val-vWaveAmp').textContent = `${p.vWaveAmp.toFixed(1)} mm`;
      document.getElementById('val-holeDia').textContent = `${p.holeDia} mm`;
      document.getElementById('val-spokeCount').textContent = `${p.spokeCount}`;
      document.getElementById('val-radSeg').textContent = `${p.radSeg}`;
      document.getElementById('val-heightSeg').textContent = `${p.heightSeg}`;
    }

    function rebuildLampshade() {
      const p = getParams();
      updateLabels(p);

      if (shadeMesh) {
        scene.remove(shadeMesh);
        shadeMesh.geometry.dispose();
      }

      const geometries = [createShellGeometry(p), ...createFitterGeometries(p)];
      const mergedGeometry = BufferGeometryUtils.mergeGeometries(geometries, false);

      shadeMesh = new THREE.Mesh(mergedGeometry, shadeMaterial);
      scene.add(shadeMesh);

      // Center bulb light inside current height
      bulbLight.position.set(0, p.height * 0.48, 0);
      bulbMesh.position.copy(bulbLight.position);

      // Update viewport stats
      mergedGeometry.computeBoundingBox();
      const bb = mergedGeometry.boundingBox;
      const sx = Math.round(bb.max.x - bb.min.x);
      const sy = Math.round(bb.max.y - bb.min.y);
      const sz = Math.round(bb.max.z - bb.min.z);
      const triCount = mergedGeometry.attributes.position.count / 3;

      document.getElementById('stats-dims').textContent = `Bounding Box: ${sx} × ${sz} × ${sy} mm`;
      document.getElementById('stats-tris').textContent = `Triangles: ${triCount.toLocaleString()}`;
    }

    // --- Event Listeners ---
    document.querySelectorAll('input, select').forEach(el => {
      if (el.id === 'socketPreset') {
        el.addEventListener('change', (e) => {
          document.getElementById('holeDia').value = e.target.value;
          rebuildLampshade();
        });
      } else if (el.id === 'lampPreview') {
        el.addEventListener('change', (e) => {
          const on = e.target.checked;
          bulbLight.visible = on;
          bulbMesh.visible = on;
          shadeMaterial.emissiveIntensity = on ? 0.18 : 0.0;
        });
      } else if (el.id === 'wireframeToggle') {
        el.addEventListener('change', (e) => {
          shadeMaterial.wireframe = e.target.checked;
        });
      } else {
        el.addEventListener('input', rebuildLampshade);
      }
    });

    // --- Presets ---
    window.applyPreset = function(name) {
      const setVal = (id, val) => { document.getElementById(id).value = val; };
      if (name === 'ribbed') {
        setVal('height', 190); setVal('bottomRadius', 75); setVal('topRadius', 55);
        setVal('profileType', 'bulge'); setVal('profileAmp', 12);
        setVal('ribCount', 36); setVal('ribDepth', 4.5); setVal('ribSharpness', 0.8);
        setVal('twistAngle', 0); setVal('vWaveFreq', 0); setVal('vWaveAmp', 0);
      } else if (name === 'twisted') {
        setVal('height', 210); setVal('bottomRadius', 65); setVal('topRadius', 40);
        setVal('profileType', 'bulge'); setVal('profileAmp', 28);
        setVal('ribCount', 18); setVal('ribDepth', 9.0); setVal('ribSharpness', 1.6);
        setVal('twistAngle', 135); setVal('vWaveFreq', 0); setVal('vWaveAmp', 0);
      } else if (name === 'origami') {
        setVal('height', 175); setVal('bottomRadius', 70); setVal('topRadius', 50);
        setVal('profileType', 'hour'); setVal('profileAmp', 16);
        setVal('ribCount', 16); setVal('ribDepth', 7.5); setVal('ribSharpness', 2.4);
        setVal('twistAngle', 60); setVal('vWaveFreq', 6); setVal('vWaveAmp', 4.5);
      }
      rebuildLampshade();
    };

    // --- STL Export (Z-Up Slicer Orientation) ---
    document.getElementById('exportBtn').addEventListener('click', () => {
      if (!shadeMesh) return;
      const exporter = new STLExporter();

      // Clone and rotate +90deg around X so Y-up becomes Z-up for 3D slicers
      const exportGeo = shadeMesh.geometry.clone();
      exportGeo.rotateX(Math.PI / 2);
      const exportMesh = new THREE.Mesh(exportGeo);

      const stlBuffer = exporter.parse(exportMesh, { binary: true });
      const blob = new Blob([stlBuffer], { type: 'application/octet-stream' });
      const url = URL.createObjectURL(blob);

      const link = document.createElement('a');
      link.href = url;
      link.download = `lampshade_${Date.now()}.stl`;
      link.click();

      URL.revokeObjectURL(url);
      exportGeo.dispose();
    });

    // --- Window Resize & Render Loop ---
    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }

    rebuildLampshade();
    animate();
  </script>
</body>
</html>

Key Features Included for 3D Printing
 * True Millimeter Scale & Slicer-Ready Orientation: All sliders operate directly in millimeters (mm) on a visual 250 × 250 mm reference build plate. Exporting automatically rotates the geometry to Z-up so it lands flat on your slicer's build plate.
 * Built-In Socket Fitter Generator: Choose between E27/E26 (41 mm), E14 (29 mm), Uno (35 mm), or custom pendant cord holes. The app generates an internal collar ring that welds to the inner ribs so there are no gaps regardless of your wave depth.
 * Watertight Manifold Shell: Generates an explicit outer wall, inner wall, top rim, and bottom rim, OR lets you disable the fitter and print in Spiral Vase Mode.
Quick Slicer & Filament Tips
 * Bulb Safety: Always use LED bulbs with 3D-printed lampshades. Standard PLA begins softening around 55–60°C; if your bulb runs warm or sits close to the hub ring, print the shade in PETG or ASA.
 * Eliminating Visible Seams: Set your slicer's Seam Position to Aligned or Sharpest Corner so the Z-seam hides neatly inside one of the vertical valleys of the ribs.
